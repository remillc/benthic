<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep links (lib/deep-link.js): opendives://sites/12 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="opendives" />
            </intent-filter>

            <!-- Verified links (App Links): https://benthicdivelog.app/sites/12 (and the old host opendives.app, kept). The paths are those of the
                 fallback page of the site (site/build.mjs); the fingerprints are in
                 site/.well-known/assetlinks.json. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="benthicdivelog.app" />
                <data android:scheme="https" android:host="opendives.app" />
                <data android:pathPrefix="/dives/at/" />
                <data android:pathPrefix="/sites/" />
                <data android:pathPrefix="/plan/" />
                <data android:pathPrefix="/plans/" />
                <data android:pathPrefix="/tools/" />
                <data android:pathPrefix="/statistics/" />
            </intent-filter>

            <!-- "Open with Benthic" on a logbook file (ACTION_VIEW on a content:// address). Mail, Drive and file
                 managers often send a logbook as application/octet-stream or text/plain: the app checks the
                 contents (lib/deep-link.js, lib/shared-file.js) and refuses what is not a logbook with a message. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-subsurface" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/vnd.benthic+zip" />
                <data android:mimeType="application/x-sqlite3" />
                <data android:mimeType="application/vnd.sqlite3" />
            </intent-filter>
            <!-- A file manager that gives no usable type: the name ends in one of the extensions of the import list
                 (the same as lib/import-formats.js; .csv needs its column mapping and is not offered). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.ssrf" />
                <data android:pathPattern=".*\\..*\\.ssrf" />
                <data android:pathPattern=".*\\..*\\..*\\.ssrf" />
                <data android:pathPattern=".*\\.SSRF" />
                <data android:pathPattern=".*\\..*\\.SSRF" />
                <data android:pathPattern=".*\\..*\\..*\\.SSRF" />
                <data android:pathPattern=".*\\.xml" />
                <data android:pathPattern=".*\\..*\\.xml" />
                <data android:pathPattern=".*\\..*\\..*\\.xml" />
                <data android:pathPattern=".*\\.XML" />
                <data android:pathPattern=".*\\..*\\.XML" />
                <data android:pathPattern=".*\\..*\\..*\\.XML" />
                <data android:pathPattern=".*\\.uddf" />
                <data android:pathPattern=".*\\..*\\.uddf" />
                <data android:pathPattern=".*\\..*\\..*\\.uddf" />
                <data android:pathPattern=".*\\.UDDF" />
                <data android:pathPattern=".*\\..*\\.UDDF" />
                <data android:pathPattern=".*\\..*\\..*\\.UDDF" />
                <data android:pathPattern=".*\\.udcf" />
                <data android:pathPattern=".*\\..*\\.udcf" />
                <data android:pathPattern=".*\\..*\\..*\\.udcf" />
                <data android:pathPattern=".*\\.UDCF" />
                <data android:pathPattern=".*\\..*\\.UDCF" />
                <data android:pathPattern=".*\\..*\\..*\\.UDCF" />
                <data android:pathPattern=".*\\.fit" />
                <data android:pathPattern=".*\\..*\\.fit" />
                <data android:pathPattern=".*\\..*\\..*\\.fit" />
                <data android:pathPattern=".*\\.FIT" />
                <data android:pathPattern=".*\\..*\\.FIT" />
                <data android:pathPattern=".*\\..*\\..*\\.FIT" />
                <data android:pathPattern=".*\\.sde" />
                <data android:pathPattern=".*\\..*\\.sde" />
                <data android:pathPattern=".*\\..*\\..*\\.sde" />
                <data android:pathPattern=".*\\.SDE" />
                <data android:pathPattern=".*\\..*\\.SDE" />
                <data android:pathPattern=".*\\..*\\..*\\.SDE" />
                <data android:pathPattern=".*\\.db" />
                <data android:pathPattern=".*\\..*\\.db" />
                <data android:pathPattern=".*\\..*\\..*\\.db" />
                <data android:pathPattern=".*\\.DB" />
                <data android:pathPattern=".*\\..*\\.DB" />
                <data android:pathPattern=".*\\..*\\..*\\.DB" />
                <data android:pathPattern=".*\\.dive" />
                <data android:pathPattern=".*\\..*\\.dive" />
                <data android:pathPattern=".*\\..*\\..*\\.dive" />
                <data android:pathPattern=".*\\.DIVE" />
                <data android:pathPattern=".*\\..*\\.DIVE" />
                <data android:pathPattern=".*\\..*\\..*\\.DIVE" />
                <data android:pathPattern=".*\\.dlf" />
                <data android:pathPattern=".*\\..*\\.dlf" />
                <data android:pathPattern=".*\\..*\\..*\\.dlf" />
                <data android:pathPattern=".*\\.DLF" />
                <data android:pathPattern=".*\\..*\\.DLF" />
                <data android:pathPattern=".*\\..*\\..*\\.DLF" />
                <data android:pathPattern=".*\\.dld" />
                <data android:pathPattern=".*\\..*\\.dld" />
                <data android:pathPattern=".*\\..*\\..*\\.dld" />
                <data android:pathPattern=".*\\.DLD" />
                <data android:pathPattern=".*\\..*\\.DLD" />
                <data android:pathPattern=".*\\..*\\..*\\.DLD" />
                <data android:pathPattern=".*\\.divelogs" />
                <data android:pathPattern=".*\\..*\\.divelogs" />
                <data android:pathPattern=".*\\..*\\..*\\.divelogs" />
                <data android:pathPattern=".*\\.DIVELOGS" />
                <data android:pathPattern=".*\\..*\\.DIVELOGS" />
                <data android:pathPattern=".*\\..*\\..*\\.DIVELOGS" />
                <data android:pathPattern=".*\\.jlb" />
                <data android:pathPattern=".*\\..*\\.jlb" />
                <data android:pathPattern=".*\\..*\\..*\\.jlb" />
                <data android:pathPattern=".*\\.JLB" />
                <data android:pathPattern=".*\\..*\\.JLB" />
                <data android:pathPattern=".*\\..*\\..*\\.JLB" />
                <data android:pathPattern=".*\\.sql" />
                <data android:pathPattern=".*\\..*\\.sql" />
                <data android:pathPattern=".*\\..*\\..*\\.sql" />
                <data android:pathPattern=".*\\.SQL" />
                <data android:pathPattern=".*\\..*\\.SQL" />
                <data android:pathPattern=".*\\..*\\..*\\.SQL" />
                <data android:pathPattern=".*\\.log" />
                <data android:pathPattern=".*\\..*\\.log" />
                <data android:pathPattern=".*\\..*\\..*\\.log" />
                <data android:pathPattern=".*\\.LOG" />
                <data android:pathPattern=".*\\..*\\.LOG" />
                <data android:pathPattern=".*\\..*\\..*\\.LOG" />
                <data android:pathPattern=".*\\.json" />
                <data android:pathPattern=".*\\..*\\.json" />
                <data android:pathPattern=".*\\..*\\..*\\.json" />
                <data android:pathPattern=".*\\.JSON" />
                <data android:pathPattern=".*\\..*\\.JSON" />
                <data android:pathPattern=".*\\..*\\..*\\.JSON" />
                <data android:pathPattern=".*\\.zip" />
                <data android:pathPattern=".*\\..*\\.zip" />
                <data android:pathPattern=".*\\..*\\..*\\.zip" />
                <data android:pathPattern=".*\\.ZIP" />
                <data android:pathPattern=".*\\..*\\.ZIP" />
                <data android:pathPattern=".*\\..*\\..*\\.ZIP" />
                <data android:pathPattern=".*\\.benthic" />
                <data android:pathPattern=".*\\..*\\.benthic" />
                <data android:pathPattern=".*\\..*\\..*\\.benthic" />
                <data android:pathPattern=".*\\.BENTHIC" />
                <data android:pathPattern=".*\\..*\\.BENTHIC" />
                <data android:pathPattern=".*\\..*\\..*\\.BENTHIC" />
            </intent-filter>

            <!-- "Share to OpenDives" (ACTION_SEND and SEND_MULTIPLE): the file is in EXTRA_STREAM; the plugin hands
                 it to the web layer as the "sharedFile" event (BenthicCorePlugin.offerSharedFiles). A share of
                 plain text without a file does nothing. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-subsurface" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-sqlite3" />
                <data android:mimeType="application/vnd.sqlite3" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- "Me prévenir quand je peux prendre l'avion": a local notification at the end of the wait
         (lib/flight-reminder.svelte.js). Android 13 and later: asked when the diver turns the
         switch on. Inexact on purpose: no SCHEDULE_EXACT_ALARM permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Use my position" on the site edit screen. Asked only when the diver
         taps it (Capacitor's WebChromeClient requests it at that moment). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Download from the dive computer (Bluetooth Low Energy and Classic),
         asked when the diver opens the download. Android 12 and later:
         "Nearby devices", the scan never used for location. Before: the
         legacy permissions, and the location above, which the scan needs. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
</manifest>
