<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground: the wave of the logo with relief (docs/brand/benthic-logo.svg) and its shadow.
     The disc is the background (ic_launcher_background.xml), so it fills the launcher's mask: no white ring.
     The wave keeps its share of the disc: drawn for a disc of radius 30, scaled by 1.2 to the visible
     circle of radius 36. No rim: on a squircle mask it would show as a ring. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.2"
        android:scaleY="1.2">
        <!-- The shadow: the wave shifted 3 down, #072A4D at 35 %. -->
        <path
            android:pathData="M34.909,59.727 Q44.455,51.545 54,59.727 T73.091,59.727"
            android:strokeColor="#59072A4D"
            android:strokeWidth="6"
            android:strokeLineCap="round" />
        <!-- The wave: one white stroke, rounded ends. -->
        <path
            android:pathData="M34.909,56.727 Q44.455,48.545 54,56.727 T73.091,56.727"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="6"
            android:strokeLineCap="round" />
    </group>
</vector>
