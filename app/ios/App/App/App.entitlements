<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links: https://benthicdivelog.app/ (and the old opendives.app)... opens the app. Needs the
	     Associated Domains capability on the App ID, and the Team ID in
	     site/.well-known/apple-app-site-association. -->
	<!-- Apple Health, read only: the dives of an Apple Watch Ultra (to-do #67). Needs the
	     HealthKit capability on the App ID. -->
	<!-- Sign in with Apple (« Continuer avec Apple »). Needs the Sign in with Apple capability on the App ID. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:benthicdivelog.app</string>
		<string>applinks:opendives.app</string>
	</array>
	<!-- Push notifications (task 2026-11-23-356). Needs the Push Notifications capability on the App ID. `development` for debug builds
	     and Xcode's own signing; Xcode and the distribution profile switch it to `production` for TestFlight and the store. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- iCloud Drive, first launch on iPhone (task 2026-11-16-261): the logbook is created in the app's container.
	     Needs the iCloud capability (iCloud Documents) and the container on the App ID. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.app.benthicdivelog</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.app.benthicdivelog</string>
	</array>
</dict>
</plist>
