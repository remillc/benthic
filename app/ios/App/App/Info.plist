<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Benthic Log</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Benthic uses Bluetooth to download your dives from your dive computer.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Benthic reads the depth and water temperature your Apple Watch Ultra recorded during your dives, to add those dives to your logbook. Nothing is written to Health.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Benthic never writes to Health. It only reads the dives your Apple Watch Ultra recorded.</string>
	<key>NSCameraUsageDescription</key>
	<string>Benthic uses the camera only to read the QR codes of a dive or a plan shared from another phone. Nothing is recorded.</string>
	<!-- Push notifications of access requests (task 2026-11-23-356): the background push that removes a notification. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.benthicdivelog</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>benthic</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.benthicdivelog.benthic</string>
			<key>UTTypeDescription</key>
			<string>Benthic file</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>benthic</string>
				</array>
				<key>public.mime-type</key>
				<string>application/vnd.benthic+zip</string>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.benthicdivelog.ssrf</string>
			<key>UTTypeDescription</key>
			<string>Subsurface logbook</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.xml</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>ssrf</string>
				</array>
				<key>public.mime-type</key>
				<string>application/x-subsurface</string>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.benthicdivelog.divefile</string>
			<key>UTTypeDescription</key>
			<string>Dive log file</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>uddf</string>
					<string>udcf</string>
					<string>fit</string>
					<string>sde</string>
					<string>dive</string>
					<string>dlf</string>
					<string>dld</string>
					<string>divelogs</string>
					<string>jlb</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Benthic file</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>app.benthicdivelog.benthic</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Subsurface logbook</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>app.benthicdivelog.ssrf</string>
				<string>public.xml</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Dive log file</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>app.benthicdivelog.divefile</string>
			</array>
		</dict>
	</array>
	<!-- The file is copied into the app (Inbox) and read once; it is not edited in place. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<!-- The app's iCloud Drive folder shows in the Files app as « Benthic » (task 2026-11-16-261). -->
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.app.benthicdivelog</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>Benthic</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
</dict>
</plist>
