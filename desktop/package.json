{
  "name": "opendives-desktop",
  "private": true,
  "description": "OpenDives, the desktop app (Windows, macOS, Linux): the app's interface in Electron, the Subsurface core in a helper process.",
  "license": "GPL-2.0-only",
  "author": "Christian Rémillard",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env OD_DEV_URL=http://localhost:5180 electron .",
    "pack": "node scripts/prepare.cjs && electron-builder --dir",
    "dist": "node scripts/prepare.cjs && electron-builder"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.opendives.app",
    "productName": "OpenDives",
    "directories": { "output": "../build/desktop/dist", "buildResources": "resources" },
    "files": ["main.cjs", "menu.cjs", "window-state.cjs", "bridge.cjs", "preload.cjs", "package.json"],
    "extraResources": [
      { "from": "../build/desktop/stage/web", "to": "web" },
      { "from": "../build/desktop/stage/bin", "to": "bin" },
      { "from": "../build/desktop/stage/xslt", "to": "xslt" },
      { "from": "../build/desktop/stage/i18n", "to": "i18n" }
    ],
    "win": { "target": ["nsis", "appx"] },
    "appx": { "identityName": "OpenDives", "publisherDisplayName": "Christian Rémillard" },
    "mac": { "target": ["dmg", "mas"], "category": "public.app-category.sports" },
    "linux": { "target": ["AppImage", "flatpak"], "category": "Utility" }
  }
}
